# セッション暗号化キー（32文字以上のランダム文字列）
NUXT_SESSION_PASSWORD=

# Google OAuth（Google Cloud Console で作成。リダイレクトURI: <origin>/auth/google と <origin>/auth/google-sheets）
# 決算シートのスプレッドシート出力も、出力する人の Google アカウントで許可をもらうのでこれを使う（README 参照）
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# ログインを許可するメールドメイン
NUXT_ALLOWED_EMAIL_DOMAIN=g.ecc.u-tokyo.ac.jp

# 最初の管理者（カンマ区切り）。ログインのたびに管理者になり、画面からは変更できない。
# ほかの人の権限（一般・財務局長・管理者）は、財務局長・管理者が「ユーザー」画面で変える
NUXT_ADMIN_EMAILS=

# DB（ローカルは file:、本番は Turso の libsql://… URL とトークン）
# Vercel で Turso を追加した場合は TURSO_DATABASE_URL / TURSO_AUTH_TOKEN が入り、こちらは空でよい
# 添付ファイルも DB に保存する
NUXT_DATABASE_URL=file:.data/app.db
NUXT_DATABASE_AUTH_TOKEN=

# n8n 通知（Slack 転送用）。口座情報は送信されない
NUXT_N8N_WEBHOOK_URL=
NUXT_N8N_WEBHOOK_SECRET=

# 期限切れの未対応をリマインドする /api/cron/overdue-reminder の合言葉（n8n のスケジュールから呼ぶとき）。
# Vercel の Cron を使うなら、代わりに Vercel の環境変数 CRON_SECRET を設定する
NUXT_CRON_SECRET=

# ローカル開発用：Google を使わずに任意のメールでログインできる（公開環境では絶対に true にしない）
NUXT_PUBLIC_DEV_LOGIN=false

# テスト公開用：ECC メール＋合言葉でログインできる
# 管理者（NUXT_ADMIN_EMAILS）として入るには NUXT_TEST_ADMIN_CODE が必要。合言葉は長めのランダムな文字列にする
NUXT_PUBLIC_TEST_LOGIN=false
NUXT_TEST_LOGIN_CODE=
NUXT_TEST_ADMIN_CODE=

# Google ログインのボタンを出す（上の OAuth を設定したら true）
NUXT_PUBLIC_GOOGLE_LOGIN=false

# 画面上部に出す環境名（例: テスト環境）。空なら出さない
NUXT_PUBLIC_ENV_LABEL=

# 振込を対応済みにするとき、使用口座の横に出す銀行サイトのリンク（ネットバンキングのログインページなど）
NUXT_PUBLIC_BANK_LINK_SMBC=https://www.smbc.co.jp/
NUXT_PUBLIC_BANK_LINK_YUCHO=https://www.jp-bank.japanpost.jp/
